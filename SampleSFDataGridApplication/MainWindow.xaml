<Window x:Class="SampleSFDataGridApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SampleSFDataGridApplication"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1000" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:ViewModel />
    </Window.DataContext>
    <StackPanel>
        <Button x:Name="ThemeToggleButton" Content="Switch to Dark Mode"
                             Width="200" Height="50"
                             HorizontalAlignment="Center" Margin="25" VerticalAlignment="Bottom"
                             Click="ThemeToggleButton_Click"/>
        
        <syncfusion:SfDataGrid x:Name="sfTreeGrid" 
                   AllowFiltering="True"
                   ItemsSource="{Binding Employees}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </StackPanel>
</Window>
